<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent widget background. A drawable (not a color int) so the launcher resolves it:
     it follows light/dark and wallpaper colors without re-rendering the widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_bg_translucent" />
</shape>
